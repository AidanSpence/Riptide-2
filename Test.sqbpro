-- ============ MUSIC ============

CREATE TABLE music_artists (
    id    INTEGER PRIMARY KEY AUTOINCREMENT,
    name  TEXT NOT NULL UNIQUE
);

CREATE TABLE music_genres (
    id    INTEGER PRIMARY KEY AUTOINCREMENT,
    name  TEXT NOT NULL UNIQUE
);

CREATE TABLE music_albums (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    title         TEXT NOT NULL,
    release_date  TEXT,                      -- ISO 'YYYY-MM-DD'
    UNIQUE (title, release_date)
);

CREATE TABLE music_songs (
    id                INTEGER PRIMARY KEY AUTOINCREMENT,
    title             TEXT NOT NULL,
    album_id          INTEGER REFERENCES music_albums(id),

    -- identifiers
    spotify_track_id  TEXT UNIQUE,
    isrc              TEXT UNIQUE,

    -- raw audio features
    bpm               REAL    CHECK (bpm &gt; 0),
    camelot           TEXT    CHECK (camelot GLOB '[1-9][AB]' OR camelot GLOB '1[0-2][AB]'),
    musical_key       INTEGER CHECK (musical_key BETWEEN 0 AND 11),
    time_signature    INTEGER CHECK (time_signature BETWEEN 1 AND 7),
    duration_s  	  INT CHECK (duration_s &gt; 0),
    loudness_db       REAL,
    energy            REAL CHECK (energy           BETWEEN 0 AND 1),
    danceability      REAL CHECK (danceability     BETWEEN 0 AND 1),
    acousticness      REAL CHECK (acousticness     BETWEEN 0 AND 1),
    instrumentalness  REAL CHECK (instrumentalness BETWEEN 0 AND 1),
    valence           REAL CHECK (valence          BETWEEN 0 AND 1),
    speechiness       REAL CHECK (speechiness      BETWEEN 0 AND 1),
    liveness          REAL CHECK (liveness         BETWEEN 0 AND 1),
    popularity        INTEGER CHECK (popularity BETWEEN 0 AND 100),
    explicit          INTEGER NOT NULL DEFAULT 0 CHECK (explicit IN (0,1)),

    -- normalized feature vector: 9 x float32 packed as a 36-byte BLOB
    features          BLOB CHECK (features IS NULL OR length(features) = 36),

    created_at        TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE TABLE music_song_artists (
    song_id    INTEGER NOT NULL REFERENCES music_songs(id)   ON DELETE CASCADE,
    artist_id  INTEGER NOT NULL REFERENCES music_artists(id) ON DELETE CASCADE,
    position   INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (song_id, artist_id)
);

CREATE TABLE music_song_genres (
    song_id   INTEGER NOT NULL REFERENCES music_songs(id)  ON DELETE CASCADE,
    genre_id  INTEGER NOT NULL REFERENCES music_genres(id) ON DELETE CASCADE,
    PRIMARY KEY (song_id, genre_id)
);

CREATE INDEX idx_song_artists_artist ON music_song_artists (artist_id);
CREATE INDEX idx_song_genres_genre   ON music_song_genres  (genre_id);
CREATE INDEX idx_songs_album         ON music_songs (album_id);
CREATE INDEX idx_songs_bpm           ON music_songs (bpm);
CREATE INDEX idx_songs_camelot       ON music_songs (camelot);

-- ============ USERS ============

CREATE TABLE app_users (
    id              TEXT PRIMARY KEY,                       -- UUID generated by the app
    email           TEXT NOT NULL UNIQUE COLLATE NOCASE,
    username        TEXT NOT NULL UNIQUE COLLATE NOCASE,
    password_hash   TEXT NOT NULL,                          -- argon2/bcrypt hash
    display_name    TEXT,
    avatar_url      TEXT,
    email_verified  INTEGER NOT NULL DEFAULT 0,
    is_active       INTEGER NOT NULL DEFAULT 1,
    created_at      TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at      TEXT NOT NULL DEFAULT (datetime('now')),
    last_login_at   TEXT
);

CREATE TABLE app_sessions (
    id          TEXT PRIMARY KEY,
    user_id     TEXT NOT NULL REFERENCES app_users(id) ON DELETE CASCADE,
    token_hash  TEXT NOT NULL UNIQUE,
    expires_at  TEXT NOT NULL,
    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE TABLE app_playlists (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id     TEXT NOT NULL REFERENCES app_users(id) ON DELETE CASCADE,
    name        TEXT NOT NULL,
    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE TABLE app_playlist_songs (
    playlist_id  INTEGER NOT NULL REFERENCES app_playlists(id) ON DELETE CASCADE,
    song_id      INTEGER NOT NULL REFERENCES music_songs(id)   ON DELETE CASCADE,
    position     INTEGER NOT NULL,
    added_at     TEXT NOT NULL DEFAULT (datetime('now')),
    PRIMARY KEY (playlist_id, song_id)
);

CREATE INDEX idx_sessions_user  ON app_sessions (user_id);
CREATE INDEX idx_playlists_user ON app_playlists (user_id);</sql><current_tab id="0"/></tab_sql></sqlb_project>
