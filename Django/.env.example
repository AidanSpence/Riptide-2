# Safe placeholders only; never commit real secrets.
# For Elastic Beanstalk, set these as environment properties.
# For local development, copy to .env and normally set DJANGO_DEBUG=1,
# DB_HOST/DB_PORT to your local database, FRONTEND_URL=http://localhost:3000,
# and SPOTIFY_REDIRECT_URI=http://127.0.0.1:9000/spotify/callback/.
DJANGO_DEBUG=0
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=riptide2-env.eba-kq3mbgdd.us-east-1.elasticbeanstalk.com,d1caj2u4jm9c3j.cloudfront.net,localhost,127.0.0.1
FRONTEND_URL=https://d1caj2u4jm9c3j.cloudfront.net
CORS_ALLOWED_ORIGINS=https://d1caj2u4jm9c3j.cloudfront.net
CSRF_TRUSTED_ORIGINS=https://d1caj2u4jm9c3j.cloudfront.net
CLOUDFRONT_ORIGIN_SECRET=replace-with-a-second-random-secret
DB_NAME=riptide
DB_USER=replace-with-rds-user
DB_PASSWORD=replace-with-rds-password
DB_HOST=replace-with-private-rds-endpoint
DB_PORT=5432
DB_SSLMODE=require
SPOTIFY_CLIENT_ID=replace-with-client-id
SPOTIFY_CLIENT_SECRET=replace-with-client-secret
SPOTIFY_REDIRECT_URI=https://d1caj2u4jm9c3j.cloudfront.net/spotify/callback/
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.deepseek.r1-v1:0
BEDROCK_MAX_TOKENS=4096
GENERATION_DAILY_LIMIT=10
GENERATION_USER_DAILY_LIMIT=5
WEB_CONCURRENCY=1
# only loads the included data when music.songs is empty
BOOTSTRAP_MUSIC=1
